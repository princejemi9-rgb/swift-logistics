# Vercel / Supabase prototype configuration. Set these in Vercel, never Git.
# Either SUPABASE_URL + SUPABASE_ANON_KEY or their supported aliases works.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional prototype email notifications. Omit both to disable email delivery.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
